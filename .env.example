# Copy this file to .env and fill in the values. Never commit .env.

# Groq — console.groq.com → API Keys
GROQ_API_KEY=

# Supabase — Project Settings → API (set up at build step 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 — Google Cloud Console → Credentials
YOUTUBE_API_KEY=
