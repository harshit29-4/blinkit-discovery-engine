# Copy this file to .env and fill in the values. Never commit .env.

# Groq — console.groq.com → API Keys
GROQ_API_KEY=

# Supabase — see docs/WALKTHROUGH.md §1 "Setting up Supabase"
# Project URL: the dashboard's Connect panel or Project Settings → API (https://<ref>.supabase.co)
SUPABASE_URL=
# Project Settings → API Keys: publishable key (sb_publishable_...), safe for the browser
SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys: secret key (sb_secret_...), server/pipeline only, never in the browser
SUPABASE_SECRET_KEY=
# Connect → "Session pooler" connection string, with your database password filled in.
# Only used to apply database migrations from this computer.
SUPABASE_DB_URL=

# Any long random string. Used to anonymise usernames (salted hash).
# Keep it the same forever, or the same author will get a different hash.
AUTHOR_HASH_SALT=
